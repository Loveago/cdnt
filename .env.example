DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"
AUTH_SECRET="generate-a-secure-random-secret"

# Paystack (Ghana) — instant wallet top-ups. Get keys at https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=""

# Initial Admin Credentials (used during db seed / initialization)
ADMIN_EMAIL="admin@mycedinet.com"
ADMIN_PASSWORD="ChooseAStrongPassword123!"
ADMIN_NAME="MyCediNet Admin"

# Multi-Domain Platform Architecture (hostnames only — do NOT include https:// or trailing slashes)
MAIN_DOMAIN="mycedinet.com"
NEXT_PUBLIC_MAIN_DOMAIN="mycedinet.com"
STOREFRONT_DOMAIN="mycedinetstore.com"
NEXT_PUBLIC_STOREFRONT_DOMAIN="mycedinetstore.com"

# MoMo SMS Forwarder Webhook Secret
SMS_FORWARDER_SECRET="your-sms-forwarder-secret"
